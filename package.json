{
  "name": "@lyeve-labs/client-react",
  "version": "0.2.2",
  "description": "React hooks for LyEve Core - typed, reactive data fetching",
  "license": "MIT",
  "author": "LyEve Labs <info@lyeve.com>",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && publint && node scripts/check-dist.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsup --watch",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "@lyeve-labs/client": ">=0.2.1",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@lyeve-labs/client": "^0.3.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.4.0",
    "publint": "^0.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
